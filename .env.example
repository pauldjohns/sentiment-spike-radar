# Copy to .env (gitignored). These two are read by the browser client at build time, so they
# are the only ones that belong in this file - and there is deliberately no fallback: the
# client throws if they are unset rather than pointing at somebody else's project.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# How many signals the UI falls back to when live data is unavailable.
FALLBACK_SIGNAL_COUNT=10

# Dev server port, and the tagger the generator injects (set to 1 to turn it off).
PORT=8080
DISABLE_LOVABLE_TAGGER=0

# --- NOT in this file ---
#
# The edge functions read their own secrets from the Supabase runtime, not from here. Set
# them with `supabase secrets set` on your project:
#
#   STOCKTWITS_API_TOKEN     sentiment ingestion
#   HUGGINGFACE_API_KEY      sentiment classification
#   FINNHUB_API_KEY          price enrichment
#   SUCCESS_THRESHOLD        grading cutoff for whether a signal paid off
#   RECENCY_PENALTY_DAYS     how fast an unproven signal decays in scoring
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform. The service-role
# key bypasses row-level security entirely - never put it in this file or in client code.
